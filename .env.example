APP_ENV=development
APP_NAME=enterprise-ai-reference-architecture
LOG_LEVEL=INFO

# OpenAI provider (optional for fully local/offline demo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30

# RAG chunking
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
